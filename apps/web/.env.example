# API Configuration
# Browser-facing API base. In local dev this points at the Next dev server,
# which proxies /api/v1/* to FLOWLIKE_UPSTREAM_API_URL to avoid browser CORS.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_FLOWLIKE_TASK_API_URL=http://localhost:3001
FLOWLIKE_UPSTREAM_API_URL=http://localhost:8081
NEXT_PUBLIC_REDIRECT_URL=http://localhost:3001/callback
NEXT_PUBLIC_REDIRECT_LOGOUT_URL=http://localhost:3001/

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
